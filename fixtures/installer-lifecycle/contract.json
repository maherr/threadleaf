{
  "schemaVersion": 1,
  "applicationId": "org.threadleaf.Threadleaf",
  "lifecycleScript": "scripts/check-installer-lifecycle.mjs",
  "unsignedCi": {
    "updateTrust": "none",
    "identityDiscovery": false,
    "requiresSigning": false,
    "evidenceDirectory": "lifecycle-artifacts"
  },
  "platforms": {
    "windows-x64": {
      "runner": "windows-2025",
      "architecture": "x64",
      "artifacts": [".exe", ".zip"],
      "install": "nsis",
      "uninstall": "silent"
    },
    "macos-x64": {
      "runner": "macos-15-intel",
      "architecture": "x64",
      "artifacts": [".dmg", ".zip"],
      "install": "dmg",
      "uninstall": "remove-app"
    }
  },
  "signedRelease": {
    "windows": ["WINDOWS_CSC_LINK", "WINDOWS_CSC_KEY_PASSWORD"],
    "macos": [
      "MAC_CSC_LINK",
      "MAC_CSC_KEY_PASSWORD",
      "APPLE_API_KEY_BASE64",
      "APPLE_API_KEY_ID",
      "APPLE_API_ISSUER"
    ],
    "trustMarker": "signed-release-v1"
  }
}
