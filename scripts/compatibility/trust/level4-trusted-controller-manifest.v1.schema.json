{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:threadleaf:compatibility:level4-trusted-controller-manifest:v1",
  "title": "Threadleaf Level 4 trusted controller manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestId",
    "manifestVersion",
    "controllerVersion",
    "controllerExecutableSha256",
    "allowedReceiptSchemaVersions",
    "currentHarness"
  ],
  "properties": {
    "manifestId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "manifestVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "controllerVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "controllerExecutableSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "allowedReceiptSchemaVersions": {
      "const": [2]
    },
    "currentHarness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "treeSha256"],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "treeSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
