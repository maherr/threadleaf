{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://threadleaf.org/schemas/reviewed-authority-profile.v1.json",
  "title": "Threadleaf reviewed community-plugin authority profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "profileId",
    "profileRevision",
    "packageIdentity",
    "packageIdentityDigest",
    "expectedStaticCapabilities",
    "requiredAuthorities",
    "executionProfile",
    "allowedPlatforms",
    "authorityDigest"
  ],
  "properties": {
    "$schema": { "const": "./reviewed-authority-profile.v1.schema.json" },
    "schemaVersion": { "const": 1 },
    "profileId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "profileRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "packageIdentity": { "$ref": "#/$defs/packageIdentity" },
    "packageIdentityDigest": { "$ref": "#/$defs/digest" },
    "expectedStaticCapabilities": { "$ref": "#/$defs/capabilities" },
    "requiredAuthorities": { "$ref": "#/$defs/capabilities" },
    "executionProfile": {
      "enum": ["trusted-node-renderer", "trusted-desktop-escape"]
    },
    "allowedPlatforms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["linux", "darwin", "win32"] }
    },
    "authorityDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,99}$"
    },
    "packageIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pluginId",
        "manifestVersion",
        "distributionTag",
        "manifestSha256",
        "mainSha256",
        "stylesSha256",
        "packageTreeSha256"
      ],
      "properties": {
        "pluginId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "manifestVersion": { "$ref": "#/$defs/version" },
        "distributionTag": { "$ref": "#/$defs/version" },
        "manifestSha256": { "$ref": "#/$defs/digest" },
        "mainSha256": { "$ref": "#/$defs/digest" },
        "stylesSha256": {
          "oneOf": [{ "$ref": "#/$defs/digest" }, { "type": "null" }]
        },
        "packageTreeSha256": { "$ref": "#/$defs/digest" }
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 11,
      "uniqueItems": true,
      "items": {
        "enum": [
          "vault-read",
          "vault-write",
          "network",
          "filesystem",
          "subprocess",
          "host-environment",
          "clipboard",
          "external-navigation",
          "editor-extension",
          "workspace-ui",
          "dynamic-code"
        ]
      }
    }
  }
}
