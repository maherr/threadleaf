{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": [
        "compatibility/registry.v1.json",
        "compatibility/obsidian-runtime-ledger.v1.json",
        "compatibility/obsidian-runtime-test-index.v1.json",
        "src/generated/plugin-compatibility-registry.ts",
        "src/generated/case-folding-table.ts",
        "src/generated/obsidian-runtime-ledger.ts",
        "benchmarks/results/*.json",
        "fixtures/search-golden/full-text-search-golden.json",
        "fixtures/corpus/same-vault-v1/cases.json",
        "fixtures/corpus/same-vault-v1/manifest.json",
        "fixtures/corpus/excalidraw-roundtrip-v1/cases.json",
        "fixtures/corpus/excalidraw-roundtrip-v1/manifest.json",
        "fixtures/corpus/excalidraw-roundtrip-v1/vault/.obsidian/workspace.json"
      ],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["compatibility/authority/obsidian-1.13.7.d.ts"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      }
    }
  ]
}
