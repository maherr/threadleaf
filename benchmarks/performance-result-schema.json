{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maherr/threadleaf/blob/main/benchmarks/performance-result-schema.json",
  "title": "Threadleaf Electron performance seam result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "suite",
    "generatedAt",
    "runtime",
    "environment",
    "configuration",
    "correctness",
    "metrics",
    "budgets",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "suite": { "const": "electron-performance-seams" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node", "electron", "threadleaf", "platform", "arch", "gitHead", "gitDirty"],
      "properties": {
        "node": { "type": "string" },
        "electron": { "type": "string" },
        "threadleaf": { "type": "string" },
        "platform": { "type": "string" },
        "arch": { "type": "string" },
        "gitHead": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "gitDirty": { "type": "boolean" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display",
        "ozonePlatform",
        "gpuDisabled",
        "cpuCount",
        "cpuModel",
        "kernel",
        "memoryTotalBytes"
      ],
      "properties": {
        "display": { "const": "xvfb" },
        "ozonePlatform": { "const": "x11" },
        "gpuDisabled": { "const": true },
        "cpuCount": { "type": "integer", "minimum": 1 },
        "cpuModel": { "type": "string", "minLength": 1 },
        "kernel": { "type": "string", "minLength": 1 },
        "memoryTotalBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["warmups", "samples", "tailStatistic", "coldDefinition", "warmDefinition"],
      "properties": {
        "warmups": { "type": "integer", "minimum": 1 },
        "samples": { "type": "integer", "minimum": 1 },
        "tailStatistic": { "const": "p90" },
        "coldDefinition": { "type": "string", "minLength": 1 },
        "warmDefinition": { "type": "string", "minLength": 1 }
      }
    },
    "correctness": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "details"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["pass", "fail"] },
          "details": { "type": "string" }
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "mode",
          "unit",
          "warmupCount",
          "sampleCount",
          "samples",
          "median",
          "tail",
          "tailStatistic",
          "minimum",
          "maximum"
        ],
        "properties": {
          "name": { "type": "string" },
          "mode": { "enum": ["cold", "warm", "baseline", "post-plugin"] },
          "unit": { "enum": ["milliseconds", "bytes"] },
          "warmupCount": { "type": "integer", "minimum": 0 },
          "sampleCount": { "type": "integer", "minimum": 1 },
          "samples": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "number", "minimum": 0 }
          },
          "median": { "type": "number", "minimum": 0 },
          "tail": { "type": "number", "minimum": 0 },
          "tailStatistic": { "const": "p90" },
          "minimum": { "type": "number", "minimum": 0 },
          "maximum": { "type": "number", "minimum": 0 },
          "details": { "type": "object" }
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluated", "enforced", "baselineHash", "checks"],
      "properties": {
        "evaluated": { "type": "boolean" },
        "enforced": { "type": "boolean" },
        "baselineHash": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["metric", "mode", "status"],
            "properties": {
              "metric": { "type": "string" },
              "mode": { "enum": ["cold", "warm", "baseline", "post-plugin"] },
              "status": { "enum": ["pass", "fail", "skipped"] },
              "reason": { "type": "string" },
              "medianRatio": { "type": "number", "minimum": 0 },
              "tailRatio": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
