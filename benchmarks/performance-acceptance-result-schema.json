{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maherr/threadleaf/blob/main/benchmarks/performance-acceptance-result-schema.json",
  "title": "Threadleaf performance acceptance result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "suite",
    "generatedAt",
    "status",
    "runtime",
    "corpus",
    "configuration",
    "legs",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "suite": { "const": "threadleaf-performance-acceptance" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["complete", "aborted"] },
    "runtime": { "type": "object" },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "variant",
        "generatorVersion",
        "seed",
        "manifestHash",
        "sampleHash",
        "fileCount",
        "visibleFileCount",
        "hiddenFileCount",
        "markdownFileCount",
        "ballastFileCount",
        "totalBytes",
        "depthProfile",
        "noteSizeDistribution",
        "extensionCounts"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "variant": { "enum": ["full", "smoke"] },
        "generatorVersion": { "type": "string" },
        "seed": { "type": "integer" },
        "manifestHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sampleHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "fileCount": { "type": "integer", "minimum": 1 },
        "visibleFileCount": { "type": "integer" },
        "hiddenFileCount": { "type": "integer" },
        "markdownFileCount": { "type": "integer" },
        "ballastFileCount": { "type": "integer" },
        "totalBytes": { "type": "integer", "minimum": 1 },
        "depthProfile": { "type": "object" },
        "noteSizeDistribution": { "type": "object" },
        "extensionCounts": { "type": "object" }
      }
    },
    "configuration": { "type": "object" },
    "legs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "electronWorkspaceOpen",
        "coldKernel",
        "warmPersistedIndex",
        "incremental",
        "timeToUsableShell",
        "backgroundCompletion",
        "memory",
        "responsiveness"
      ],
      "properties": {
        "electronWorkspaceOpen": { "$ref": "#/$defs/electronLeg" },
        "coldKernel": { "$ref": "#/$defs/coldKernelLeg" },
        "warmPersistedIndex": { "$ref": "#/$defs/abortedLeg" },
        "incremental": { "$ref": "#/$defs/generalLeg" },
        "timeToUsableShell": { "$ref": "#/$defs/generalLeg" },
        "backgroundCompletion": { "$ref": "#/$defs/generalLeg" },
        "memory": { "$ref": "#/$defs/generalLeg" },
        "responsiveness": { "$ref": "#/$defs/generalLeg" }
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "generalLeg": {
      "type": "object",
      "required": ["status", "timeoutMs", "machine"],
      "properties": {
        "status": { "enum": ["complete", "aborted"] },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 1500000 },
        "machine": { "type": "object" }
      }
    },
    "abortedLeg": {
      "allOf": [
        { "$ref": "#/$defs/generalLeg" },
        {
          "properties": {
            "status": { "const": "aborted" },
            "reason": { "type": "string" }
          },
          "required": ["reason"]
        }
      ]
    },
    "coldKernelLeg": {
      "type": "object",
      "required": ["status", "timeoutMs", "machineBefore", "machineAfter"],
      "properties": {
        "status": { "enum": ["complete", "aborted"] },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 1500000 },
        "machineBefore": { "type": "object" },
        "machineAfter": { "type": "object" }
      }
    },
    "electronLeg": {
      "type": "object",
      "required": [
        "status",
        "startedAt",
        "completedAt",
        "timeoutMs",
        "machine",
        "usableShellMs",
        "backgroundCompletionMs",
        "responsivenessProbes",
        "rss",
        "finalSurface"
      ],
      "properties": {
        "status": { "enum": ["complete", "aborted"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": "string", "format": "date-time" },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 1500000 },
        "machine": { "type": "object" },
        "usableShellMs": { "type": ["number", "null"], "minimum": 0 },
        "backgroundCompletionMs": { "type": ["number", "null"], "minimum": 0 },
        "responsivenessProbes": { "type": "array", "minItems": 0, "maxItems": 3 },
        "rss": { "type": "object" },
        "finalSurface": { "type": ["object", "null"] },
        "reason": { "type": "string" }
      }
    }
  }
}
