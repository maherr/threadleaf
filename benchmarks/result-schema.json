{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maherr/threadleaf/blob/main/benchmarks/result-schema.json",
  "title": "Threadleaf deterministic scale benchmark result",
  "type": "object",
  "required": [
    "schemaVersion",
    "generatedAt",
    "profile",
    "corpus",
    "runtime",
    "configuration",
    "correctness",
    "metrics",
    "memoryObservation",
    "budgets",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "profile": { "enum": ["smoke", "standard", "large"] },
    "corpus": {
      "type": "object",
      "required": ["profile", "seed", "noteCount", "attachmentCount", "totalBytes", "manifestHash"],
      "properties": {
        "profile": { "type": "string" },
        "seed": { "type": "integer", "minimum": 0 },
        "noteCount": { "type": "integer", "minimum": 1 },
        "attachmentCount": { "type": "integer", "minimum": 0 },
        "totalBytes": { "type": "integer", "minimum": 1 },
        "manifestHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": ["node", "platform", "arch", "cpuCount", "electron"],
      "properties": {
        "node": { "type": "string" },
        "platform": { "type": "string" },
        "arch": { "type": "string" },
        "cpuCount": { "type": "integer", "minimum": 1 },
        "electron": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "configuration": {
      "type": "object",
      "required": ["warmups", "samples", "tailStatistic"],
      "properties": {
        "warmups": { "type": "integer", "minimum": 1 },
        "samples": { "type": "integer", "minimum": 2 },
        "tailStatistic": { "const": "p90" }
      },
      "additionalProperties": false
    },
    "correctness": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status", "details"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["pass", "fail"] },
          "details": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "unit",
          "warmupCount",
          "sampleCount",
          "samples",
          "median",
          "tail",
          "tailStatistic",
          "minimum",
          "maximum"
        ],
        "properties": {
          "name": { "type": "string" },
          "unit": { "enum": ["milliseconds", "bytes"] },
          "warmupCount": { "type": "integer", "minimum": 0 },
          "sampleCount": { "type": "integer", "minimum": 2 },
          "samples": {
            "type": "array",
            "minItems": 2,
            "items": { "type": "number", "minimum": 0 }
          },
          "median": { "type": "number", "minimum": 0 },
          "tail": { "type": "number", "minimum": 0 },
          "tailStatistic": { "const": "p90" },
          "minimum": { "type": "number", "minimum": 0 },
          "maximum": { "type": "number", "minimum": 0 },
          "details": {
            "type": "object",
            "additionalProperties": { "type": ["number", "string", "boolean"] }
          }
        },
        "additionalProperties": false
      }
    },
    "memoryObservation": {
      "type": "object",
      "required": ["rssBytes", "heapUsedBytes", "note"],
      "properties": {
        "rssBytes": { "type": "integer", "minimum": 0 },
        "heapUsedBytes": { "type": "integer", "minimum": 0 },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "budgets": {
      "type": "object",
      "required": ["evaluated", "baselineHash", "checks"],
      "properties": {
        "evaluated": { "type": "boolean" },
        "baselineHash": { "type": ["string", "null"] },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["metric", "status"],
            "properties": {
              "metric": { "type": "string" },
              "status": { "enum": ["pass", "fail", "skipped"] },
              "reason": { "type": "string" },
              "medianRatio": { "type": "number", "minimum": 0 },
              "tailRatio": { "type": "number", "minimum": 0 }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
