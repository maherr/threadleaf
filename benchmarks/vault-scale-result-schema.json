{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/maherr/threadleaf/blob/main/benchmarks/vault-scale-result-schema.json",
  "title": "Threadleaf synthetic vault-scale startup benchmark result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "suite",
    "generatedAt",
    "status",
    "runtime",
    "environment",
    "corpus",
    "configuration",
    "correctness",
    "runs",
    "agreement",
    "error",
    "limitations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "suite": { "const": "vault-scale-startup" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "status": { "enum": ["complete", "aborted"] },
    "runtime": { "type": "object" },
    "environment": { "type": "object" },
    "corpus": {
      "type": "object",
      "required": [
        "variant",
        "generatorVersion",
        "seed",
        "fileCount",
        "visibleFileCount",
        "hiddenFileCount",
        "markdownFileCount",
        "ballastFileCount",
        "totalBytes",
        "manifestSampleHash",
        "noteSizeDistribution",
        "depthProfile",
        "extensionCounts"
      ],
      "properties": {
        "variant": { "enum": ["full", "notes-only"] },
        "generatorVersion": { "type": "string" },
        "seed": { "type": "integer" },
        "fileCount": { "type": "integer" },
        "visibleFileCount": { "type": "integer" },
        "hiddenFileCount": { "type": "integer" },
        "markdownFileCount": { "type": "integer" },
        "ballastFileCount": { "type": "integer" },
        "totalBytes": { "type": "integer" },
        "manifestSampleHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "noteSizeDistribution": { "type": "object" },
        "depthProfile": { "type": "object" },
        "extensionCounts": { "type": "object" }
      },
      "additionalProperties": true
    },
    "configuration": { "type": "object" },
    "correctness": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "details"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["pass", "aborted"] },
          "details": { "type": "string" }
        }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "runIndex", "kernel", "cold", "warm"],
        "properties": {
          "status": { "enum": ["complete", "aborted"] },
          "runIndex": { "type": "integer", "minimum": 1 },
          "kernel": {
            "anyOf": [
              { "type": "null" },
              { "$ref": "#/$defs/kernelSuccess" },
              { "$ref": "#/$defs/kernelFailure" }
            ]
          },
          "cold": {
            "anyOf": [
              { "type": "null" },
              { "$ref": "#/$defs/runLegSuccess" },
              { "$ref": "#/$defs/runLegAborted" }
            ]
          },
          "warm": {
            "anyOf": [
              { "type": "null" },
              { "$ref": "#/$defs/runLegSuccess" },
              { "$ref": "#/$defs/runLegAborted" }
            ]
          }
        }
      }
    },
    "agreement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runs", "bounds", "status", "metrics"],
      "properties": {
        "runs": { "type": "integer", "minimum": 0 },
        "bounds": { "type": "object" },
        "status": {
          "enum": ["insufficient-runs", "insufficient-data", "within-bounds", "outside-bounds"]
        },
        "metrics": { "type": "array" }
      }
    },
    "error": {
      "type": ["object", "null"],
      "if": { "type": "object" },
      "then": {
        "required": ["message", "completedRuns", "observedRuns", "kernelError", "partial"],
        "properties": {
          "message": { "type": "string" },
          "completedRuns": { "type": "integer", "minimum": 0 },
          "observedRuns": { "type": "integer", "minimum": 0 },
          "kernelError": {
            "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/kernelFailure" }]
          },
          "partial": { "type": ["object", "null"] }
        },
        "additionalProperties": false
      }
    },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "kernelSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "variant",
        "corpus",
        "timings",
        "incremental",
        "memory",
        "responsiveness"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "variant": { "enum": ["full", "notes-only"] },
        "corpus": { "type": "object" },
        "timings": { "type": "object" },
        "incremental": { "type": "object" },
        "memory": { "type": "object" },
        "responsiveness": { "type": "object" }
      }
    },
    "kernelFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "message", "code", "signal", "timedOut", "stderrTail", "memorySafety"],
      "properties": {
        "status": { "const": "aborted" },
        "message": { "type": "string" },
        "code": { "type": ["string", "number", "null"] },
        "signal": { "type": ["string", "null"] },
        "timedOut": { "type": "boolean" },
        "stderrTail": { "type": "string" },
        "memorySafety": { "type": "object" }
      }
    },
    "runLegSuccess": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "mode",
        "runIndex",
        "startup",
        "incremental",
        "memory",
        "responsiveness",
        "exit"
      ],
      "properties": {
        "status": { "const": "complete" },
        "mode": { "enum": ["cold", "warm"] },
        "runIndex": { "type": "integer", "minimum": 1 },
        "startup": { "type": "object" },
        "incremental": { "type": ["object", "null"] },
        "memory": { "type": "object" },
        "responsiveness": { "type": "object" },
        "exit": { "type": "object" }
      }
    },
    "runLegAborted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "mode", "runIndex", "error", "partial"],
      "properties": {
        "status": { "const": "aborted" },
        "mode": { "enum": ["cold", "warm"] },
        "runIndex": { "type": "integer", "minimum": 1 },
        "error": { "type": "string" },
        "partial": { "type": ["object", "null"] }
      }
    }
  }
}
