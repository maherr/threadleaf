{
  "name": "threadleaf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "An open runtime for local Markdown vaults and community plugins.",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/main/main.cjs",
  "bin": {
    "threadleaf": "dist/main/cli.cjs"
  },
  "scripts": {
    "build": "pnpm run build:main && pnpm run build:renderer && pnpm run build:verify",
    "build:main": "tsup",
    "build:renderer": "vite build",
    "build:verify": "node scripts/check-built-app.mjs",
    "benchmark:search": "vitest bench --run src/kernel/full-text-search.bench.ts",
    "check": "pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run build",
    "cli": "pnpm run build:main && node dist/main/cli.cjs",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "start": "electron .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.1",
    "electron": "43.3.0",
    "jsdom": "30.0.1",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@lezer/highlight": "1.2.3",
    "codemirror": "6.0.2",
    "dompurify": "3.4.13",
    "markdown-it": "15.0.0"
  }
}
