{
  "name": "threadleaf",
  "version": "0.1.0-beta.3",
  "private": true,
  "type": "module",
  "description": "An open runtime for local Markdown vaults and community plugins.",
  "author": "Threadleaf contributors",
  "homepage": "https://github.com/maherr/threadleaf",
  "repository": {
    "type": "git",
    "url": "https://github.com/maherr/threadleaf.git"
  },
  "bugs": {
    "url": "https://github.com/maherr/threadleaf/issues"
  },
  "desktopName": "threadleaf.desktop",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "dist/main/main.cjs",
  "exports": {
    ".": "./dist/main/main.cjs",
    "./native-extension": {
      "types": "./src/native-extension/index.ts",
      "default": "./dist/main/native-extension.cjs"
    },
    "./native-extension/sdk": {
      "types": "./src/native-extension/sdk.ts",
      "default": "./dist/main/native-extension-sdk.cjs"
    }
  },
  "bin": {
    "threadleaf": "dist/main/cli.cjs"
  },
  "scripts": {
    "build": "pnpm run build:main && pnpm run build:renderer && pnpm run build:verify",
    "build:main": "tsup",
    "build:renderer": "vite build",
    "build:verify": "node scripts/check-built-app.mjs",
    "benchmark:search": "vitest bench --run src/kernel/full-text-search.bench.ts",
    "build:benchmarks": "tsup --config benchmarks/tsup.config.ts",
    "benchmark:corpus": "pnpm run build:benchmarks >/dev/null && node .bench-dist/runner.cjs --integrity --profile smoke",
    "benchmark:scale": "pnpm run build:benchmarks >/dev/null && node .bench-dist/runner.cjs",
    "benchmark:scale:check": "pnpm run build:benchmarks >/dev/null && node .bench-dist/runner.cjs --enforce-budgets",
    "check": "pnpm run compatibility:check && pnpm run corpus:check && pnpm run test:installer-lifecycle-config && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run build",
    "cli": "pnpm run build:main && node dist/main/cli.cjs",
    "corpus:check": "pnpm run build:main && node dist/main/corpus.cjs",
    "compatibility:check": "node scripts/generate-plugin-compatibility-registry.mjs --check",
    "compatibility:generate": "node scripts/generate-plugin-compatibility-registry.mjs",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "pack:dir": "pnpm run build && electron-builder --linux dir --x64 --publish never",
    "pack:linux": "pnpm run build && electron-builder --linux AppImage rpm --x64 --publish never",
    "pack:mac:arm64": "pnpm run build && electron-builder --mac dmg zip --arm64 --publish never --config.mac.identity=null --config.mac.hardenedRuntime=false",
    "pack:mac:universal": "pnpm run build && electron-builder --mac dmg zip --universal --publish never --config.mac.forceCodeSigning=true --config.extraMetadata.threadleafUpdateTrust=signed-release-v1",
    "pack:mac:x64": "pnpm run build && electron-builder --mac dmg zip --x64 --publish never --config.mac.identity=null --config.mac.hardenedRuntime=false",
    "pack:windows": "pnpm run build && electron-builder --win nsis zip --x64 --publish never",
    "pack:windows:signed": "pnpm run build && electron-builder --win nsis zip --x64 --publish never --config.win.forceCodeSigning=true --config.extraMetadata.threadleafUpdateTrust=signed-release-v1",
    "release:linux": "pnpm run check && pnpm run pack:linux && pnpm run test:linux-packages && node scripts/package-reproducible-linux.mjs --write",
    "start": "electron .",
    "test": "vitest run",
    "test:packaged": "pnpm run pack:dir && xvfb-run -a node scripts/check-packaged-app.mjs && xvfb-run -a node scripts/check-packaged-properties.mjs",
    "test:linux-packages": "node scripts/check-linux-packages.mjs",
    "test:live-preview": "pnpm run build && node scripts/check-live-preview.mjs",
    "test:note-bookmarks": "pnpm run build && node scripts/check-note-bookmarks.mjs",
    "test:publish-export": "pnpm run build && node scripts/check-publish-export.mjs",
    "test:note-workflows": "pnpm run build && node scripts/check-note-workflows.mjs",
    "test:macos-package": "node scripts/check-macos-package.mjs",
    "test:installer-lifecycle": "node scripts/check-installer-lifecycle.mjs",
    "test:installer-lifecycle-config": "node scripts/check-installer-lifecycle-config.mjs",
    "test:package-reproducible": "pnpm run build && node scripts/package-reproducible-linux.mjs",
    "test:plugin-index-live": "THREADLEAF_LIVE_PLUGIN_INDEX=1 vitest run src/main/open-plugin-package-source.live.test.ts",
    "test:plugin-package-inspection": "pnpm run build:main && node scripts/check-plugin-package-inspection-e2e.mjs",
    "test:plugin-packages-e2e": "pnpm run build && node scripts/check-plugin-packages-e2e.mjs",
    "test:migration-apply": "pnpm run build && node scripts/check-migration-apply.mjs",
    "test:plugin-recovery": "pnpm run build && node scripts/check-plugin-recovery.mjs",
    "test:editor-reliability": "pnpm run build && node scripts/check-editor-reliability.mjs",
    "test:appearance-watcher": "pnpm run build && node scripts/check-appearance-watcher.mjs",
    "test:file-recovery": "pnpm run build && node scripts/check-file-recovery.mjs",
    "test:graph-view": "pnpm run build && node scripts/check-graph-view.mjs",
    "test:representative-vault": "pnpm run build && node scripts/check-representative-vault.mjs",
    "test:startup-readiness": "pnpm run build && node scripts/check-startup-readiness.mjs",
    "test:support-bundle": "pnpm run build && node scripts/check-support-bundle.mjs",
    "test:upgrade-rollback": "node scripts/check-upgrade-rollback.mjs",
    "test:pinned-tabs": "pnpm run build && node scripts/check-pinned-tabs.mjs",
    "test:workspace-panes": "pnpm run build && node scripts/check-workspace-panes.mjs",
    "test:windows-package": "node scripts/check-windows-package.mjs",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.20.1",
    "@types/turndown": "5.0.6",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "jsdom": "30.0.1",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.8",
    "@lezer/common": "1.5.2",
    "@lezer/highlight": "1.2.3",
    "@lezer/lr": "1.4.10",
    "codemirror": "6.0.2",
    "dompurify": "3.4.13",
    "electron-updater": "6.8.9",
    "lucide": "1.31.0",
    "markdown-it": "15.0.0",
    "moment": "^2.30.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "turndown": "7.2.4",
    "yaml": "2.8.1"
  }
}
