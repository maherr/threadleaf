{
  "schemaVersion": 1,
  "uri": "urn:threadleaf:spec:v1:themes",
  "threadleafVersion": "0.1.0-beta.3",
  "colorSchemes": ["system", "light", "dark"],
  "themeContract": {
    "version": 1,
    "uri": "urn:threadleaf:theme:v1",
    "tokens": [
      {
        "name": "--background-primary",
        "role": "surface"
      },
      {
        "name": "--background-primary-alt",
        "role": "surface-raised"
      },
      {
        "name": "--background-secondary",
        "role": "surface-sunken"
      },
      {
        "name": "--background-secondary-alt",
        "role": "surface-sunken-alt"
      },
      {
        "name": "--background-modifier-border",
        "role": "border"
      },
      {
        "name": "--background-modifier-border-hover",
        "role": "border-strong"
      },
      {
        "name": "--background-modifier-hover",
        "role": "surface-hover"
      },
      {
        "name": "--background-modifier-error",
        "role": "signal-soft"
      },
      {
        "name": "--text-normal",
        "role": "text-primary"
      },
      {
        "name": "--text-muted",
        "role": "text-secondary"
      },
      {
        "name": "--text-faint",
        "role": "text-muted"
      },
      {
        "name": "--text-accent",
        "role": "accent-strong"
      },
      {
        "name": "--text-accent-hover",
        "role": "accent-hover"
      },
      {
        "name": "--text-error",
        "role": "signal"
      },
      {
        "name": "--icon-color",
        "role": "icon"
      },
      {
        "name": "--color-accent",
        "role": "accent"
      },
      {
        "name": "--interactive-accent",
        "role": "accent"
      },
      {
        "name": "--interactive-accent-hover",
        "role": "accent-hover"
      },
      {
        "name": "--canvas",
        "role": "canvas"
      },
      {
        "name": "--surface",
        "role": "surface"
      },
      {
        "name": "--surface-raised",
        "role": "surface-raised"
      },
      {
        "name": "--surface-sunken",
        "role": "surface-sunken"
      },
      {
        "name": "--ink",
        "role": "text-primary"
      },
      {
        "name": "--ink-soft",
        "role": "text-secondary"
      },
      {
        "name": "--ink-muted",
        "role": "text-muted"
      },
      {
        "name": "--line",
        "role": "border"
      },
      {
        "name": "--line-strong",
        "role": "border-strong"
      },
      {
        "name": "--accent",
        "role": "accent"
      },
      {
        "name": "--accent-strong",
        "role": "accent-strong"
      },
      {
        "name": "--accent-soft",
        "role": "accent-soft"
      },
      {
        "name": "--interactive",
        "role": "accent"
      },
      {
        "name": "--signal",
        "role": "signal"
      },
      {
        "name": "--signal-soft",
        "role": "signal-soft"
      },
      {
        "name": "--font-interface",
        "role": "interface-font"
      },
      {
        "name": "--font-text",
        "role": "text-font"
      },
      {
        "name": "--font-monospace",
        "role": "monospace-font"
      },
      {
        "name": "--file-margins",
        "role": "file-margin"
      },
      {
        "name": "--radius-s",
        "role": "small-radius"
      },
      {
        "name": "--radius-m",
        "role": "medium-radius"
      },
      {
        "name": "--radius-l",
        "role": "large-radius"
      }
    ],
    "stateCues": [
      {
        "state": "selected",
        "cue": "aria-current, aria-pressed, or an equivalent visible label plus a border or shape"
      },
      {
        "state": "warning",
        "cue": "status text or an announced warning symbol plus a non-color border style"
      },
      {
        "state": "error",
        "cue": "status text or an announced error symbol plus a non-color border style"
      },
      {
        "state": "loading",
        "cue": "status text or an announced progress state, never color alone"
      }
    ],
    "schemes": ["light", "dark", "high-contrast-light", "high-contrast-dark"],
    "source": "src/shared/theme-contract.ts"
  },
  "assetIds": [
    {
      "kind": "theme",
      "prefix": "obsidian-theme:",
      "source": "src/shared/appearance.ts#appearanceAssetIdPatterns"
    },
    {
      "kind": "snippet",
      "prefix": "obsidian-snippet:",
      "source": "src/shared/appearance.ts#appearanceAssetIdPatterns"
    }
  ],
  "limits": [
    {
      "id": "themeCssBytes",
      "bytes": 2097152,
      "unit": "bytes",
      "source": "src/main/vault-appearance-loader.ts#maxThemeBytes",
      "display": "2,097,152 bytes"
    },
    {
      "id": "snippetCssBytes",
      "bytes": 524288,
      "unit": "bytes",
      "source": "src/main/vault-appearance-loader.ts#maxSnippetBytes",
      "display": "524,288 bytes"
    },
    {
      "id": "manifestBytes",
      "bytes": 65536,
      "unit": "bytes",
      "source": "src/main/vault-appearance-loader.ts#maxManifestBytes",
      "display": "65,536 bytes"
    },
    {
      "id": "combinedActiveCssBytes",
      "bytes": 4194304,
      "unit": "bytes",
      "source": "src/main/vault-appearance-loader.ts#maxCombinedCssBytes",
      "display": "4,194,304 bytes"
    },
    {
      "id": "catalogEntries",
      "bytes": 256,
      "unit": "entries",
      "source": "src/main/vault-appearance-loader.ts#maxCatalogEntries",
      "display": "256 entries"
    }
  ],
  "cascade": [
    {
      "order": 1,
      "layer": "Threadleaf baseline",
      "source": "docs/compatibility/themes.md#Cascade-order"
    },
    {
      "order": 2,
      "layer": "Selected theme",
      "source": "docs/compatibility/themes.md#Cascade-order"
    },
    {
      "order": 3,
      "layer": "Enabled snippets in persisted order",
      "source": "docs/compatibility/themes.md#Cascade-order"
    }
  ],
  "gates": [
    {
      "path": "src/shared/theme-contract.test.ts",
      "command": "pnpm test"
    },
    {
      "path": "src/main/vault-appearance-loader.test.ts",
      "command": "pnpm test"
    },
    {
      "path": "scripts/check-appearance-watcher.mjs",
      "command": "pnpm test:appearance-watcher"
    }
  ]
}
